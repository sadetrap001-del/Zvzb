<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/scrim"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Saat ve tarih. Aşağı kaydır: bildirimler. Saate dokun: alarmlar. Tarihe dokun: takvim. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="22dp"
        android:paddingEnd="26dp"
        android:paddingBottom="18dp">

        <TextClock
            android:id="@+id/clock"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:textSize="76sp" />

        <TextClock
            android:id="@+id/date"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="d MMMM EEEE"
            android:format24Hour="d MMMM EEEE"
            android:textColor="@color/muted"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Arama çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/glass"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="@color/muted" />

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/clear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/press"
            android:contentDescription="@string/clear"
            android:src="@drawable/ic_clear"
            android:tint="@color/muted"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/press"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more"
            android:tint="@color/text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="4"
            android:overScrollMode="never"
            android:paddingStart="8dp"
            android:paddingTop="14dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="6dp" />

        <TextView
            android:id="@+id/empty"
            style="@style/Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:text="@string/loading"
            android:textColor="@color/muted"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- Alta sabitlenen uygulamalar -->
    <FrameLayout
        android:id="@+id/dockBar"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/glass">

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/dockHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/dock_hint"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
