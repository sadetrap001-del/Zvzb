<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape><corners android:radius="28dp" /><solid android:color="#3A3F4D" /></shape>
            </item>
            <item android:state_focused="true">
                <shape>
                    <corners android:radius="28dp" />
                    <solid android:color="@color/accent" />
                    <stroke android:width="3dp" android:color="#FFFFFF" />
                </shape>
            </item>
            <item>
                <shape><corners android:radius="28dp" /><solid android:color="@color/accent" /></shape>
            </item>
        </selector>
    </item>
</ripple>
