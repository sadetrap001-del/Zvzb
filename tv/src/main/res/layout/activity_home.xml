<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- Seçili uygulamanın afişinden üretilen bulanık arka plan -->
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/freeMemory"
                style="@style/Chip"
                android:nextFocusDown="@+id/grid"
                android:text="@string/free_memory" />

            <Button
                android:id="@+id/settings"
                style="@style/Chip"
                android:nextFocusDown="@+id/grid"
                android:text="@string/settings" />

            <Button
                android:id="@+id/keeper"
                style="@style/Chip"
                android:nextFocusDown="@+id/grid" />

            <Button
                android:id="@+id/hidden"
                style="@style/Chip"
                android:nextFocusDown="@+id/grid"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:format12Hour="d MMMM EEEE"
                    android:format24Hour="d MMMM EEEE"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#AA000000"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shadowColor="#AA000000"
            android:shadowRadius="8"
            android:text="@string/loading"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <!-- Bir tam sıra görünür, alttaki sıranın ucu görünür kalır. -->
        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:horizontalSpacing="14dp"
            android:listSelector="@android:color/transparent"
            android:nextFocusUp="@id/freeMemory"
            android:numColumns="6"
            android:paddingStart="8dp"
            android:paddingTop="16dp"
            android:paddingEnd="8dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="14dp" />
    </LinearLayout>
</FrameLayout>
