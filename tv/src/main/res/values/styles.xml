<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0D0E12</color>
    <color name="surface">#15171D</color>
    <color name="surface2">#1C1F27</color>
    <color name="line">#2A2E39</color>
    <color name="text">#ECEEF3</color>
    <color name="muted">#8C93A3</color>
    <color name="accent">#FF5A36</color>
    <color name="accent2">#FFB02E</color>

    <style name="HomeTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/home_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
